<Window x:Class="Foodpr.MainWindow"
        WindowState="Maximized"
        ResizeMode="CanResize"
         MinHeight="500"
 MinWidth="652"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Foodpr"
        mc:Ignorable="d"
        Title="MainWindow" Height="468" Width="430">
    <Border BorderBrush="#F26522" 
            BorderThickness="2" 
            CornerRadius="10" 
            Background="White" 
            Margin="15"
            Height="auto"
           
             VerticalAlignment="Top" 
            >           
        <Grid>

            <Border Background="#F26522" CornerRadius="9,9,0,0" Margin="0,-1,0,338" Height="50">

                <Label Content="Food Order" HorizontalAlignment="Center" VerticalAlignment="Center" Width="104" Foreground="White" Background="#FFF26522" Height="33" FontSize="18"/>
            </Border>
            <Image HorizontalAlignment="Left" Height="34" VerticalAlignment="Top" Width="46" Source="/WhatsApp Image 2026-10-13 at 9.55.41 PM.jpeg" Margin="26,5,0,0">
                <Image.OpacityMask>
                    <ImageBrush Stretch="None" ImageSource="/JANVI.png"/>
                </Image.OpacityMask>
            </Image>



            <Label Content="Select Items :" HorizontalAlignment="Left" Margin="12,46,0,0" VerticalAlignment="Top" Width="84" Height="25" FontWeight="Bold"/>
            <CheckBox x:Name="ckburgur" Content="Burger" HorizontalAlignment="Left" Margin="16,73,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="ckpizza" Content="Pizza" HorizontalAlignment="Left" Margin="16,92,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="ckpasta" Content="Pasta" HorizontalAlignment="Left" Margin="16,110,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="ckfr" Content="French Fries" HorizontalAlignment="Left" Margin="16,129,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="ckcold_d" Content="Cold Drink" HorizontalAlignment="Left" Margin="16,147,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="ckice" Content="Ice cream" HorizontalAlignment="Left" Margin="16,167,0,0" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="109,73,0,0" TextWrapping="Wrap" Text="(₹ 120)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <TextBlock HorizontalAlignment="Left" Margin="109,91,0,0" TextWrapping="Wrap" Text="(₹ 250)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <TextBlock HorizontalAlignment="Left" Margin="109,109,0,0" TextWrapping="Wrap" Text="(₹ 110)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <TextBlock HorizontalAlignment="Left" Margin="109,127,0,0" TextWrapping="Wrap" Text="(₹ 70)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <TextBlock HorizontalAlignment="Left" Margin="109,145,0,0" TextWrapping="Wrap" Text="(₹ 20)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <TextBlock HorizontalAlignment="Left" Margin="110,164,0,0" TextWrapping="Wrap" Text="(₹ 35)" VerticalAlignment="Top" RenderTransformOrigin="0.518,0.956"/>
            <Image HorizontalAlignment="Left" Height="100" Margin="444,67,0,0" VerticalAlignment="Top" Width="99" Source="/WhatsApp Image 2026-10-13 at 10.22.34 PM.jpeg"/>
            <Border Margin="10,191,10,193" BorderBrush="Black" BorderThickness="0.5" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Label Content="Total Items :" HorizontalAlignment="Left" Margin="12,196,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Label Content="Total Price :" HorizontalAlignment="Left" Margin="12,224,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Label Content="Tax (5%) :" HorizontalAlignment="Left" Margin="12,253,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Label x:Name="lbitem" HorizontalAlignment="Left" Margin="143,196,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Label x:Name="lbprice" HorizontalAlignment="Left" Margin="143,224,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Label x:Name="lbtex" HorizontalAlignment="Left" Margin="143,253,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Border Margin="10,289,10,56" BorderThickness="1" CornerRadius="5" Background="#FFFFDBBB"></Border>
            <Label Content="Total Amount :" HorizontalAlignment="Left" Margin="12,297,0,0" VerticalAlignment="Top" Width="87" Height="25"/>
            <Label x:Name="lbtam" HorizontalAlignment="Left" Margin="143,297,0,0" VerticalAlignment="Top" Width="84" Height="25"/>
            <Border CornerRadius="5" BorderBrush="#FF1586E9" BorderThickness="2" Padding="0" Height="25" Width="100" Margin="24,354,272,8" >
                <Button Content="➕ INSERT" Cursor="Hand" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Background="#FF1586E9">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                        Background="#0D6EFD" 
                        BorderBrush="#0B5ED7" 
                        BorderThickness="1" 
                        CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#0B5ED7"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0A58CA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#0A58CA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
            <Border CornerRadius="5" BorderBrush="#23944F" BorderThickness="2" Padding="0" Height="25" Width="100" Margin="143,354,153,8" >
                <Button Content="👁️ VIEW" Cursor="Hand" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Background="#23944F" Click="Button_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                        Background="#198754" 
                        BorderBrush="#157347" 
                        BorderThickness="1" 
                        CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#157347"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#146C43"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#146C43"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
            <Border CornerRadius="5" BorderBrush="#DC2626" BorderThickness="2" Padding="0" Height="25" Width="100" Margin="268,354,28,8" >
                <Button Content="🗑 DELETE" Cursor="Hand" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Background="#DC2626">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                        Background="#DC3545" 
                        BorderBrush="#BB2D3B" 
                        BorderThickness="1" 
                        CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#BB2D3B"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#B02A37"/>
                                </Trigger>
                               
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#B02A37"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>